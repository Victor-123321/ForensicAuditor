# Copy to `.env` and edit. Everything here is optional: without a .env
# the app talks to an Ollama on this same machine (http://localhost:11434).
#
# These variables override the settings saved from the UI's "Modelo local"
# panel (~/.forensic_auditor/config.json), so a .env passed around the
# team is the quickest way to put everybody on the same server.

# --- Local model, served from another laptop on the LAN ----------------
# The IP of the machine running `ollama serve` with OLLAMA_HOST=0.0.0.0.
# Any of these forms work -- the client normalizes them:
#   192.168.1.50          192.168.1.50:11434
#   http://192.168.1.50:11434                  (canonical)
#   http://192.168.1.50:11434/api/generate     (as handed out by the server setup)
# Servidor del equipo durante el hackathon (verificado el 2026-09-11 desde
# la red del Tec). Si cambia de IP, corre `python -m scripts.check_ollama`.
OLLAMA_URL=http://10.22.233.98:11434
OLLAMA_MODEL=qwen2.5:7b

# How long the server keeps the model loaded between our messages. Long,
# so nobody pays the cold start twice during the demo.
OLLAMA_KEEP_ALIVE=30m

# Context window and how long we wait for a reply. The timeout is
# deliberately generous: a 7B model loading cold can take minutes.
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.7

# Steps the ReAct loop may take before it gives up (agent/loop.py).
AGENT_MAX_STEPS=12

# --- Cloud model, reserved for case-file synthesis and /ask (FR-15) ----
# Also used as the one-shot fallback if the LAN server is unreachable.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
