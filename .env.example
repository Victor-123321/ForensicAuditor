# Copy to `.env` and edit. Everything here is optional: without a .env
# the app talks to an Ollama on this same machine (http://localhost:11434).
#
# These variables override the settings saved from the UI's "Modelo local"
# panel (~/.forensic_auditor/config.json), so a .env passed around the
# team is the quickest way to put everybody on the same server.

# --- Local model, served from another laptop on the LAN -----------------
# Drives every intermediate ReAct step (FR-15). The IP of the machine
# running `ollama serve` with OLLAMA_HOST=0.0.0.0. Any of these forms
# work -- the client normalizes them:
#   192.168.1.50          192.168.1.50:11434
#   http://192.168.1.50:11434                  (canonical)
#   http://192.168.1.50:11434/api/generate     (as handed out by the server setup)
# Servidor del equipo durante el hackathon (verificado el 2026-09-11 desde
# la red del Tec). Si cambia de IP, corre `python -m scripts.check_ollama`.
OLLAMA_URL=http://10.22.233.98:11434
OLLAMA_MODEL=qwen2.5:7b

# How long the server keeps the model loaded between our messages. Long,
# so nobody pays the cold start twice during the demo.
OLLAMA_KEEP_ALIVE=30m

# Context window and how long we wait for a reply. The timeout is
# deliberately generous: a 7B model loading cold can take minutes.
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.7

# Max tool-call/reasoning steps per investigation (FR-13, NFR-3).
AGENT_MAX_STEPS=12

# --- Who reasons each step ----------------------------------------------
# ollama: the LAN server above. cortex: Snowflake Cortex, with the
# SNOWFLAKE_ACCOUNT / SNOWFLAKE_PAT from the Snowflake section below --
# no laptop on the wifi needed, ~2-3s per step instead of 20-45s.
# llama3.1-70b is the only model that answered on the team's trial
# account (GCP us-central1). README "Running modes" has the trade-offs.
AGENT_LLM=ollama
CORTEX_MODEL=llama3.1-70b

# --- Cloud model (Google Gemini), for case-file synthesis and /ask ----
# Capped at <=2 calls/investigation (NFR-4): case-file narrative
# synthesis (agent/loop.py) and the /ask follow-up (agent/qa.py). Also
# the one-shot fallback if the LAN server above is unreachable.
#
# Get a key free at https://aistudio.google.com (AI Studio -> "Get API
# key"). No card required. If anyone on the team has a student email,
# the MLH/Google student plan is worth redeeming instead: a free year
# with 4x the usage limits.
#
# Leave this empty and NOTHING breaks: the investigation keeps the local
# model's narrative and /ask answers from the LAN model instead. Verify
# that path at least once before the demo -- it is the plan B if the
# free quota runs out in front of the judges.
CLOUD_LLM_API_KEY=

# Rolling alias on purpose. Do NOT pin a dated version here: if Google
# retires it mid-competition the demo dies with a 404.
CLOUD_LLM_MODEL=gemini-flash-latest

# --- Snowflake (docs/snowflake-integracion.md) ---------------------------
# local: the graph is built on this laptop, exactly as before.
# snowflake: each generated estate is loaded into the warehouse, the SQL
# and Cortex detectors run there, and only the flagged entities (plus the
# audited company and the accounts the money moves through) reach the
# graph. Any failure falls back to local and the sidebar says so.
# Costs ~4-5s per graph build warm (~10s the first time after starting
# the API), and the scenario picker builds twice.
DATA_SOURCE=local

# Account identifier, ORGNAME-ACCOUNTNAME (what comes before
# .snowflakecomputing.com), and a Programmatic Access Token. The curl in
# section 7 of the doc must answer 200 before any of this can work.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
# Keep these filled or delete the lines: a blank value is read as an
# empty name, not as "use the default".
SNOWFLAKE_WAREHOUSE=FORENSIC_WH
SNOWFLAKE_DATABASE=FORENSIC_AUDITOR
SNOWFLAKE_SCHEMA=ESTATE
